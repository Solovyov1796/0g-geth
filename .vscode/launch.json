{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "local debug",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/build/bin/geth",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config",
                "${workspaceFolder}/geth-config.toml",
                "--datadir",
                "${workspaceFolder}/.tmp/geth",
                "--networkid",
                "99999",
            ],
            "showLog": true,
            "trace": "verbose",
            "preLaunchTask": "go_build"
        },
        {
            "name": "ci debug",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/build/ci.go",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "debug",
                "${workspaceFolder}/cmd/geth"
            ],
            "showLog": true,
            "trace": "verbose",
            "buildFlags": "-tags=none",
        },
    ]
}