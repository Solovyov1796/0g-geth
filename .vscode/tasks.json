{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "go_build",
            "command": "go",
            "args": [
                "run",
                "${workspaceFolder}/build/ci.go",
                "debug",
                "${workspaceFolder}/cmd/geth",
            ],
            "dependsOn": [
                "clean_bin"
            ]
        },
        {
            "type": "shell",
            "label": "clean_bin",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/build/bin/geth"
            ]
        },
        {
            "type": "shell",
            "label": "remove_eth_home",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/.tmp/geth"
            ]
        },
    ]
}